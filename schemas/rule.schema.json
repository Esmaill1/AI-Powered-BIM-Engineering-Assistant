{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rulecheck.local/schemas/rule.schema.json",
  "title": "RuleDefinition",
  "description": "Deterministic rule specification generated by the RuleCheck LLM pipeline or by manual authoring. Review status is derived, not stored: is_expressible=false -> 'not_expressible'; non-empty unresolved_parameters -> 'unresolved'; otherwise 'ok'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "source_quote", "severity", "is_expressible"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of this schema the rule conforms to. Used to migrate saved rule sets."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for the rule (e.g., UUID or hierarchical slug)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Short human-readable title summarizing the requirement."
    },
    "source_quote": {
      "type": "string",
      "description": "Verbatim text excerpt from the BEP/EIR the rule was derived from. Empty string for manually authored rules with no source."
    },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"],
      "description": "Severity level assigned to non-compliant elements."
    },
    "is_expressible": {
      "type": "boolean",
      "description": "True if the requirement is fully expressible in this schema. False if out of scope or too complex."
    },
    "unexpressible_reason": {
      "type": "string",
      "minLength": 1,
      "description": "Explanation provided when is_expressible is false."
    },
    "unresolved_parameters": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Parameters mentioned in the requirement that do not exist in the active model vocabulary."
    },
    "target": { "$ref": "#/definitions/target" },
    "check": { "$ref": "#/definitions/check" }
  },
  "if": {
    "properties": { "is_expressible": { "const": false } },
    "required": ["is_expressible"]
  },
  "then": {
    "required": ["unexpressible_reason"]
  },
  "else": {
    "required": ["target", "check"]
  },
  "definitions": {
    "scalar": {
      "type": ["string", "number", "boolean"]
    },
    "target": {
      "type": "object",
      "description": "Defines which Revit elements this rule applies to.",
      "additionalProperties": false,
      "required": ["categories"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Target Revit category names (e.g., ['Doors', 'Windows'])."
        },
        "element_kind": {
          "type": "string",
          "enum": ["instance", "type", "both"],
          "default": "instance",
          "description": "Whether instance elements, type elements, or both are evaluated."
        },
        "where": {
          "type": "array",
          "description": "Optional conjunction (AND) of conditions filtering target elements before checking.",
          "items": { "$ref": "#/definitions/condition" }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "operator", "value"],
      "properties": {
        "parameter": { "type": "string", "minLength": 1 },
        "operator": {
          "type": "string",
          "enum": ["equals", "not_equals", "contains", "in", "greater_than", "less_than"]
        },
        "value": {
          "oneOf": [
            { "$ref": "#/definitions/scalar" },
            { "type": "array", "minItems": 1, "items": { "type": ["string", "number"] } }
          ]
        },
        "unit": { "$ref": "#/definitions/unit" }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "in" } } },
          "then": { "properties": { "value": { "type": "array" } } },
          "else": { "properties": { "value": { "$ref": "#/definitions/scalar" } } }
        },
        {
          "if": { "properties": { "operator": { "enum": ["greater_than", "less_than"] } } },
          "then": { "properties": { "value": { "type": "number" } } }
        }
      ]
    },
    "unit": {
      "type": "string",
      "enum": ["mm", "cm", "m", "in", "ft", "mm2", "m2", "ft2", "m3", "ft3", "deg", "rad"],
      "description": "Unit of a numeric threshold. Values are converted to Revit internal units before comparison. Omit for unitless numbers."
    },
    "check": {
      "type": "object",
      "description": "The single deterministic check evaluated against target elements.",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["required_parameter", "pattern", "allowed_values", "range", "unique", "placement", "not_unused"]
        },
        "parameter": { "type": "string", "minLength": 1, "description": "Parameter under inspection." },
        "regex": { "type": "string", "minLength": 1, "description": "Regular expression (.NET syntax, full-match) for 'pattern'." },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "Allowed discrete values for 'allowed_values' (compared as display strings)."
        },
        "case_sensitive": { "type": "boolean", "default": true, "description": "Case sensitivity for 'pattern' and 'allowed_values'." },
        "min": { "type": "number", "description": "Inclusive lower bound for 'range'." },
        "max": { "type": "number", "description": "Inclusive upper bound for 'range'." },
        "unit": { "$ref": "#/definitions/unit" },
        "scope": {
          "type": "string",
          "enum": ["model", "category", "level"],
          "default": "category",
          "description": "Uniqueness scope for 'unique'."
        },
        "placement_kind": {
          "type": "string",
          "enum": ["room_assigned", "level_assigned"],
          "description": "Required spatial assignment for 'placement'."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "required_parameter" } } },
          "then": { "required": ["parameter"] }
        },
        {
          "if": { "properties": { "type": { "const": "pattern" } } },
          "then": { "required": ["parameter", "regex"] }
        },
        {
          "if": { "properties": { "type": { "const": "allowed_values" } } },
          "then": { "required": ["parameter", "values"] }
        },
        {
          "if": { "properties": { "type": { "const": "range" } } },
          "then": {
            "required": ["parameter"],
            "anyOf": [{ "required": ["min"] }, { "required": ["max"] }]
          }
        },
        {
          "if": { "properties": { "type": { "const": "unique" } } },
          "then": { "required": ["parameter"] }
        },
        {
          "if": { "properties": { "type": { "const": "placement" } } },
          "then": { "required": ["placement_kind"] }
        }
      ]
    }
  }
}
